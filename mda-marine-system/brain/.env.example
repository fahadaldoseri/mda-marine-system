# متغيّرات بيئة نظام «مركز الوعي بالمجال البحري»
# انسخ هذا الملف إلى .env ثم املأ القيم — ولا تُرفع القيم الحقيقية إلى أي مستودع.
#   cp .env.example .env && chmod 600 .env
#
# ملاحظة: الشيفرة لا تحتاج هذا الملف إلزاميًا؛ كل قيمة لها افتراضي آمن أو مسار بديل
# مُوثَّق أدناه. الملف مطلوب فقط عند تغيير مسار أو تشغيل خارج بيئة Manus.

# ── 1) المسارات (اختيارية: الافتراضي يُستنتج من موقع الملف نفسه) ──
#BRAIN_DIR=/home/ubuntu/brain-marine-news      # جذر شجرة النظام
#SITE_DIR=/home/ubuntu/seawatch                # جذر شجرة الموقع
#BACKUP_REPO_DIR=/home/ubuntu/mda-marine-system  # وجهة النسخة الاحتياطية على GitHub
#SKILLS_HOME=/home/ubuntu                      # جذر مجلد المهارات (تثبيت مهارة MACR)

# ── 2) تسليم تلغرام (مطلوب للتسليم اليومي) ──
# بدون التوكن: يُبنى الإصدار ويُنشر على الموقع ويُسلَّم في المحادثة، ويُسجَّل سبب تعذّر تلغرام.
#TELEGRAM_BOT_TOKEN=                # توكن البوت من @BotFather — لا يُكتب في أي ملف عام
#TELEGRAM_OWNER_CHAT_ID=            # معرّف محادثة صاحب القرار (يعتمد الموافقات على المشتركين)
#TELEGRAM_WEBHOOK_SECRET=           # سر التحقق من الويب هوك — يُخزَّن في state/webhook-secret.txt

# ── 3) خدمة الويب هوك (حاوية النشر على منصة Manus) ──
#DATABASE_URL=mysql://user:pass@host:3306/db   # تُوفَّرها المنصة تلقائيًا عند تفعيل قاعدة البيانات
#PORT=3000
#SITE_ORIGIN=https://seawatch-xp4qirmr.manus.space

# ── 4) مفاتيح نماذج لغوية (اختيارية — للتكيّف التحليلي والمراجعة الآلية) ──
# في بيئة Manus تُوفَّر تلقائيًا؛ خارجها تُضاف يدويًا.
#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=

# ── 5) مفاتيح تشغيل مؤقتة (لا تُثبَّت في .env) ──
# SKIP_FORMAT_GATE=1   # تجاوز بوابة الشكل أثناء المعايرة فقط — ممنوع في التسليم المعتمد