{
  "name": "MDA — مركز الوعي بالمجال البحري",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },
  "containerEnv": {
    "BRAIN_DIR": "${containerWorkspaceFolder}/brain",
    "SITE_DIR": "${containerWorkspaceFolder}/site",
    "TZ": "Asia/Bahrain",
    "PYTHONUNBUFFERED": "1",
    "PIP_DISABLE_PIP_VERSION_CHECK": "1"
  },
  "remoteUser": "vscode",
  "postCreateCommand": "bash brain/bootstrap.sh",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "معاينة الموقع الدائم",
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "files.eol": "\n",
        "files.encoding": "utf8",
        "files.trimTrailingWhitespace": false,
        "editor.insertSpaces": true,
        "editor.tabSize": 4,
        "editor.rulers": [100],
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "terminal.integrated.defaultProfile.linux": "bash"
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "timonwong.shellcheck"
      ]
    }
  }
}
