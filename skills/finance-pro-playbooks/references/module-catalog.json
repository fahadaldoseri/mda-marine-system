  "merge_rules": {
    "boundary_rule": "Existing material processing (investment decision review, meeting minutes, opportunity screening) and new material production (Teaser, ECM dossier, research materials) are both handled by the corporate-finance plugin; distinguish at the task level: existing material processing should use deal-screening-scorecard / pre-ic-consistency-review / meeting-minutes (materials_review payload), new material production should use the remaining tasks in the deal-materials group.",
    "notes": "Task-level patterns in references/corporate-finance/task-catalog.json select the specialist task, and requires_research_upstream adds equity-research when a research verb is present."
  },
  "governance_tier": {
    "default": "light",
    "full_conditions": [
      {
        "id": "transaction-request",
        "condition": "transaction_requested is true or any transaction-prohibition risk flag is triggered",
        "reason": "A transaction request must be converted to a manual plan; no governance tier can authorize execution."
      },
      {
        "id": "professional-artifact",
        "condition": "Deliverable is an editable professional attachment (xlsx/docx/pptx model or transaction materials) or any specialist task is triggered.",
        "reason": "Attachments must follow the full formatting and validation suite."
      },
      {
        "id": "institutional-audience",
        "condition": "audience is investment_committee / buyer / seller",
        "reason": "Institutional use"
      },
      {
        "id": "sensitive-materials",
        "condition": "User uploaded sensitive materials (VDR, holdings, recordings) or privacy trigger words are matched.",
        "reason": "Privacy is non-negotiable."
      }
    ],
    "light_required_references": [
      "Matched domain md",
      "references/metric-dictionary.md (only when calculations are involved)",
      "references/output-contracts.md (envelope subsection)"
    ],
    "light_restrictions": "Result objects with governance_tier=light must not contain xlsx/docx/pptx attachments and must not set execution.external_side_effect=true; on violation validate_result must raise an error and require reprocessing via the full channel."
  },
