  "area_value_format": {
    "sea_only": "<اسم المنطقة البحرية>",
    "with_place": "<الموقع الدقيق كما في المصدر> - <المنطقة البحرية>",
    "examples": [
      "مضيق هرمز",
      "البحرين - الخليج العربي",
      "باكستان - المحيط الهندي",
      "خورفكان - خليج عُمان"
