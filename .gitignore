# مخلفات تشغيل
__pycache__/
*.pyc
.DS_Store
*.tmp
.pytest_cache/

# أسرار — لا تُرفع أبدًا
state/webhook-secret.txt
.env
.env.*
# قوالب البيئة تُرفع: بلا قيم سرية — والقيمة الحقيقية تُوضع في .env المحلي فقط
!.env.example
*.key
*.pem
secrets/

# مخرجات مولّدة
site/dist/
site/shots/
brain/shots/

# احتياطيات محلية لا تُتتبَّع
*.bak
*.bak-*

# أسرار التشغيل: لا تُتبع أبدًا (D-0638)
brain/secrets/secrets.env
brain/secrets/*.env
!brain/secrets/secrets.env.example

# ملف حالة سر الويب هوك (قيمة سرّية) — لا يُتبع
brain/state/webhook-secret.txt
brain/state/webhook-secret*.txt
