# متغيّرات بيئة مشروع الموقع (خدمة الويب هوك لبوت تلغرام)
# انسخ إلى .env واملأ القيم — لا تُرفع القيم الحقيقية إلى أي مستودع.
#   cp .env.example .env && chmod 600 .env

# ── المسارات (اختيارية) ──
#BRAIN_DIR=/home/ubuntu/brain-marine-news
#SITE_DIR=/home/ubuntu/seawatch

# ── خدمة الويب هوك ──
#TELEGRAM_BOT_TOKEN=            # توكن البوت — تُقرأ منه خدمة الويب هوك
#TELEGRAM_WEBHOOK_SECRET=       # سر التحقق: الطلبات بلا هذا السر تُرفض (فشل مغلق)
#TELEGRAM_OWNER_CHAT_ID=        # صاحب القرار: وحده يعتمد إضافة المشتركين
#SITE_ORIGIN=https://seawatch-xp4qirmr.manus.space
#PORT=3000
#DATABASE_URL=mysql://user:pass@host:3306/db   # تُوفَّرها المنصة عند تفعيل قاعدة البيانات

# تنبيه: غياب TELEGRAM_WEBHOOK_SECRET يُبقي الخدمة في حالة رفض — لا تُشغَّل بلا سر.